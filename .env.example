# ---- Database ----
DATABASE_URL="postgresql://gamepulse:gamepulse@localhost:5432/gamepulse?schema=public"

# ---- Redis / BullMQ ----
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"

# ---- Auth ----
# Generate strong values for production: openssl rand -hex 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-please"
JWT_ACCESS_TTL="900"          # 15 minutes (seconds)
JWT_REFRESH_TTL="1209600"     # 14 days (seconds)

# ---- Ingestion ----
INGEST_RATE_LIMIT_MAX=10000   # requests per window per API key
INGEST_RATE_LIMIT_WINDOW="1 minute"
INGEST_MAX_BATCH=500          # max events per POST /events call

# ---- Dashboard ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
